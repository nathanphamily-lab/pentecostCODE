# Firebase web config. Copy this file to `.env.local` (gitignored) and fill in
# the values from your Firebase project settings → Web app config.
# These EXPO_PUBLIC_ vars are inlined at build time and are NOT secret (Firebase
# web config is shipped in the client), but keep real values in .env.local.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
